{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixput.cerebraljuice.co/schemas/snapshot.v1.json",
  "title": "DisplayMaid-Next Snapshot",
  "description": "On-disk format for a window-arrangement snapshot keyed to a display configuration. Source of truth: data-model.md in this feature folder. Stable v1 — additive changes only without a schemaVersion bump.",
  "type": "object",
  "required": ["schemaVersion", "id", "displayConfigurationID", "displays", "capturedAt", "trigger", "windows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Snapshot schema version. Loaders that don't recognize the value log and skip the file."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$",
      "description": "UUID v4 — stable identifier for this snapshot file."
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "Optional user-supplied label (Story 5). Absent for auto-captures."
    },
    "displayConfigurationID": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,}$",
      "description": "Deterministic ID computed from the connected displays' fingerprints (FR-001)."
    },
    "displays": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/display" }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 with fractional seconds. UTC."
    },
    "trigger": {
      "type": "string",
      "enum": ["screensaverStart", "displaySleep", "screenLock", "manual", "displayConfigChange"],
      "description": "Capture trigger source (FR-005)."
    },
    "windows": {
      "type": "array",
      "items": { "$ref": "#/$defs/windowEntry" }
    }
  },
  "$defs": {
    "displayFingerprint": {
      "type": "object",
      "required": ["id", "vendorID", "productID", "modelNumber", "serialNumber"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{16,}$" },
        "vendorID": { "type": "integer", "minimum": 0 },
        "productID": { "type": "integer", "minimum": 0 },
        "modelNumber": { "type": "integer", "minimum": 0 },
        "serialNumber": { "type": "integer", "minimum": 0, "description": "Low 24 bits only" },
        "displayUUID": { "type": "string", "description": "Diagnostic; not part of fingerprint id" }
      }
    },
    "display": {
      "type": "object",
      "required": ["fingerprint", "bounds", "isPrimary", "scaleFactor"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": { "$ref": "#/$defs/displayFingerprint" },
        "bounds": { "$ref": "#/$defs/rect" },
        "isPrimary": { "type": "boolean" },
        "scaleFactor": { "type": "number", "minimum": 1.0 }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "windowIdentity": {
      "description": "Tagged union — exactly one of the variant keys is present.",
      "oneOf": [
        { "type": "object", "required": ["documentPath"], "additionalProperties": false,
          "properties": { "documentPath": { "type": "string", "format": "uri" } } },
        { "type": "object", "required": ["browserTabSet"], "additionalProperties": false,
          "properties": { "browserTabSet": { "type": "array", "items": { "type": "string", "format": "uri" } } } },
        { "type": "object", "required": ["editorWorkspace"], "additionalProperties": false,
          "properties": { "editorWorkspace": { "type": "string", "format": "uri" } } },
        { "type": "object", "required": ["terminalCWD"], "additionalProperties": false,
          "properties": { "terminalCWD": { "type": "string", "format": "uri" } } },
        { "type": "object", "required": ["titleRegex"], "additionalProperties": false,
          "properties": { "titleRegex": { "type": "object", "required": ["pattern", "capturedValue"],
            "properties": { "pattern": { "type": "string" }, "capturedValue": { "type": "string" } } } } },
        { "type": "object", "required": ["ordinal"], "additionalProperties": false,
          "properties": { "ordinal": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "windowEntry": {
      "type": "object",
      "required": ["bundleID", "identity", "displayFingerprintID", "spaceIndex", "frame", "isMinimized", "isFullscreen", "capturedAt"],
      "additionalProperties": false,
      "properties": {
        "bundleID": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+$",
          "description": "macOS bundle identifier (e.g. com.brave.Browser, com.microsoft.VSCode)."
        },
        "identity": { "$ref": "#/$defs/windowIdentity" },
        "displayFingerprintID": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,}$",
          "description": "References the fingerprint.id of the display this window was on at capture (FR-004)."
        },
        "spaceIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the Space on that display (from CGSCopyManagedDisplaySpaces). 0 if Space resolution failed (degraded mode per ADR-0001)."
        },
        "frame": { "$ref": "#/$defs/rect" },
        "isMinimized": { "type": "boolean" },
        "isFullscreen": { "type": "boolean" },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
