---
import BaseLayout from '../layouts/BaseLayout.astro';

// LemonSqueezy product URL — replace with the actual product link from
// the LS dashboard once the product is created.
const LEMONSQUEEZY_BUY_URL = 'https://pixput.lemonsqueezy.com/buy/REPLACE_WITH_PRODUCT_ID';
---
<BaseLayout
    title="Buy PixlPut — $19 one-time"
    description="Purchase a PixlPut license. One-time payment, 3 Macs, includes a year of updates. 30-day refund window."
    path="/buy"
>
    <section class="buy container">
        <h1>Get PixlPut</h1>
        <p class="lede">$19. One-time. Three Macs. License key emailed instantly.</p>

        <div class="card">
            <h2>What you get</h2>
            <ul>
                <li>Lifetime license for PixlPut</li>
                <li>Activates on up to 3 Macs (release a slot anytime)</li>
                <li>Free updates for 1 year</li>
                <li>14-day trial built in — try before you buy</li>
                <li>30-day refund window, no questions asked</li>
            </ul>

            <a id="ls-buy" href={LEMONSQUEEZY_BUY_URL} class="btn btn-primary" data-overlay="1">Continue to checkout</a>

            <p class="fine">
                Checkout is handled by Lemon Squeezy (our merchant of record).
                Card details never touch our server. You'll receive your license key by email — paste it into PixlPut → menu bar → License…
            </p>
        </div>

        <div class="card alt">
            <h2>Already have a key?</h2>
            <p>Open PixlPut, click the menu bar icon → License…, paste your key, click Activate.</p>
        </div>
    </section>

    <!--
        Lemon Squeezy checkout overlay. Loading this script and giving the
        button `data-overlay="1"` opens the checkout inline rather than
        navigating away. If the script fails to load (CSP, ad-blocker),
        the link falls back to opening the LS-hosted page directly.
    -->
    <script src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>
</BaseLayout>

<style>
    .buy {
        padding: 80px 0;
        max-width: 720px;
        margin: 0 auto;
    }
    .buy h1 {
        font-size: 44px;
        letter-spacing: -0.02em;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .buy .lede {
        color: var(--text-dim);
        font-size: 18px;
        margin-bottom: 32px;
    }
    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 20px;
    }
    .card h2 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 16px;
    }
    .card ul {
        list-style: none;
        padding: 0;
        margin: 0 0 24px;
    }
    .card li {
        padding: 8px 0;
        color: var(--text-dim);
        border-bottom: 1px solid var(--border);
        font-size: 14px;
    }
    .card li:last-child { border: none; }
    .card .fine {
        margin-top: 18px;
        font-size: 13px;
        color: var(--text-dim);
        line-height: 1.55;
    }
    .card.alt {
        background: transparent;
    }
</style>
