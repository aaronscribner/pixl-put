{
  "name": "pixput-license-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "schema:apply": "wrangler d1 execute pixput-licenses --file=./schema.sql --remote",
    "schema:apply:local": "wrangler d1 execute pixput-licenses --file=./schema.sql --local",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "license:sign-test": "tsx scripts/sign-test-license.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "itty-router": "^5.0.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
